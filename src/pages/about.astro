---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Window from '@/components/os/Window.astro';
import ContactLinks from '@/components/ContactLinks.astro';
import Tag from '@/components/Tag.astro';
import { site, skills } from '@/config/site';
import { Content } from '@/data/about.md';
---

<BaseLayout title="Обо мне" description={`${site.name} — ${site.role}`}>
  <Window variant="page" title="~/about.md" tabs={[{ label: 'about.md', active: true }]}>
    <div class="about">
      <div class="about__main reveal">
        <p class="about__comment mono">&lt;!-- {site.role} --&gt;</p>
        <h1 class="about__title">{site.name}</h1>
        <div class="prose about__text">
          <Content />
        </div>

        <h2 class="about__h2" id="stack"><span class="mono">## </span>Стек</h2>
        <div class="skills">
          {
            skills.map((g) => (
              <div class="skills__group">
                <h3>{g.title}</h3>
                <ul>
                  {g.items.map((s) => (
                    <li>
                      <Tag>{s}</Tag>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="about__side" id="contacts">
        <p class="about__side-title mono">Контакты</p>
        <ContactLinks variant="list" />
        <p class="about__side-title mono">Где</p>
        <p>{site.location}</p>
        {site.openToWork && <p class="about__open mono">● открыт к предложениям</p>}
      </aside>
    </div>
  </Window>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
  }

  .about__main {
    padding: var(--space-6) var(--space-7) var(--space-7);
    min-width: 0;
  }

  .about__comment {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .about__title {
    margin-top: var(--space-3);
    font-size: var(--text-display);
    letter-spacing: -0.035em;
  }

  .about__text {
    margin-top: var(--space-5);
  }

  .about__h2 {
    margin: var(--space-7) 0 var(--space-4);
    font-size: var(--text-2xl);
  }

  .about__h2 span {
    font-weight: 400;
    font-size: 0.75em;
    color: var(--color-text-subtle);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-3);
  }

  .skills__group {
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: rgb(255 255 255 / 0.02);
  }

  .skills__group h3 {
    font-size: 15px;
    margin-bottom: var(--space-3);
  }

  .skills__group ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .about__side {
    padding: var(--space-6) var(--space-5);
    border-left: 1px solid var(--color-line);
    background: var(--color-inset);
  }

  .about__side-title {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: var(--space-6) 0 var(--space-3);
  }

  .about__side-title:first-child {
    margin-top: 0;
  }

  .about__open {
    margin-top: var(--space-4);
    font-size: 12.5px;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__main {
      padding: var(--space-5) var(--space-4) var(--space-6);
    }

    .about__side {
      border-left: 0;
      border-top: 1px solid var(--color-line);
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
