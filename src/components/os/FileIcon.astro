---
interface Props {
  label: string;
  color?: string;
  size?: number;
}
const { label, color = '#e5534b', size = 40 } = Astro.props;
---

<svg viewBox="0 0 48 60" width={size} height={size * 1.25} aria-hidden="true">
  <path d="M4 4a3 3 0 0 1 3-3h24l13 13v42a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z" fill="#e9eaee"></path>
  <path d="M31 1v10a3 3 0 0 0 3 3h10z" fill="#c4c7cf"></path>
  <rect x="4" y="38" width="40" height="13" fill={color}></rect>
  <text x="24" y="48" font-family="JetBrains Mono Variable, monospace" font-size="9" font-weight="700" fill="#fff" text-anchor="middle">{label}</text>
</svg>
