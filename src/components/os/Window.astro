---
/**
 * Окно «операционной системы».
 * На рабочем столе (variant="desktop") окна позиционируются абсолютно, их можно таскать.
 * На внутренних страницах (variant="page") это большое окно по центру.
 * На телефоне все окна выстраиваются в ленту.
 */
interface Tab {
  label: string;
  href?: string;
  active?: boolean;
}

interface Props {
  id?: string;
  title: string;
  tabs?: Tab[];
  variant?: 'desktop' | 'page';
  /** Позиция на рабочем столе: left/top в %, width в px */
  x?: number;
  y?: number;
  width?: number;
  z?: number;
  focus?: boolean;
  /** Куда ведёт зелёная кнопка «развернуть» */
  href?: string;
  /** Окно без отступов внутри (для своих раскладок) */
  flush?: boolean;
  class?: string;
  /** Подпись справа в заголовке */
  meta?: string;
}

const {
  id,
  title,
  tabs,
  variant = 'desktop',
  x = 10,
  y = 5,
  width = 480,
  z = 1,
  focus = false,
  href,
  flush = false,
  class: className,
  meta,
} = Astro.props;

const style =
  variant === 'desktop' ? `--x:${x}%;--y:${y}%;--w:${width}px;z-index:${z}` : undefined;
---

<section
  id={id}
  class:list={['win', `win--${variant}`, { 'is-focused': focus, 'win--flush': flush }, className]}
  style={style}
  aria-label={title}
  data-window
  data-href={href}
>
  <header class="win__bar" data-drag-handle>
    <div class="win__lights">
      <button class="light light--close" type="button" aria-label="Закрыть окно" data-win-close></button>
      <button class="light light--min" type="button" aria-label="Свернуть окно" data-win-close></button>
      {
        href ? (
          <a class="light light--max" href={href} aria-label="Открыть на всю страницу" />
        ) : (
          <span class="light light--max" aria-hidden="true" />
        )
      }
    </div>
    <span class="win__title mono">{title}</span>
    {meta ? <span class="win__meta mono">{meta}</span> : <span class="win__meta" />}
  </header>

  {
    tabs && tabs.length > 0 && (
      <nav class="win__tabs mono" aria-label="Вкладки">
        {tabs.map((t) =>
          t.href && !t.active ? (
            <a href={t.href} class="win__tab">
              {t.label}
            </a>
          ) : (
            <span class:list={['win__tab', { 'is-active': t.active }]}>{t.label}</span>
          ),
        )}
      </nav>
    )
  }

  <div class="win__body">
    <slot />
  </div>
</section>

<style>
  .win {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-win);
    box-shadow: var(--shadow-win);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .win--desktop {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: min(var(--w), calc(100% - 2rem));
  }

  .win--page {
    position: relative;
    width: min(1120px, 100%);
    margin-inline: auto;
  }

  .win__bar {
    flex: none;
    height: 34px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    user-select: none;
  }

  .win--desktop .win__bar {
    cursor: grab;
  }

  :global(.is-dragging) .win__bar {
    cursor: grabbing;
  }

  .win__lights {
    display: flex;
    gap: 7px;
  }

  .light {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #3a3d44;
    transition: background var(--duration-fast);
  }

  .is-focused .light--close,
  .win--page .light--close {
    background: var(--color-red);
  }

  .is-focused .light--min,
  .win--page .light--min {
    background: var(--color-yellow);
  }

  .is-focused .light--max,
  .win--page .light--max {
    background: var(--color-green);
  }

  .win--page .light--close,
  .win--page .light--min {
    pointer-events: none;
  }

  .win__title {
    color: #b9bbc2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win__meta {
    justify-self: end;
    opacity: 0.75;
    white-space: nowrap;
  }

  .win__tabs {
    flex: none;
    display: flex;
    height: 32px;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-xs);
    background: var(--color-inset);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .win__tab {
    display: flex;
    align-items: center;
    padding: 0 var(--space-4);
    color: var(--color-text-muted);
    border-right: 1px solid var(--color-line);
    white-space: nowrap;
  }

  a.win__tab:hover {
    color: var(--color-text);
    background: var(--color-hover);
  }

  .win__tab.is-active {
    color: var(--color-text);
    background: var(--color-panel-2);
    box-shadow: inset 0 -1.5px 0 var(--color-red);
  }

  .win__body {
    flex: 1;
    min-height: 0;
  }

  /* Телефон и узкие экраны: окна в ленту */
  @media (max-width: 1100px) {
    .win--desktop {
      position: relative;
      left: auto !important;
      top: auto !important;
      width: 100%;
      z-index: auto !important;
    }

    .win__bar {
      cursor: default !important;
    }

    .light--close,
    .light--min {
      pointer-events: none;
    }
  }
</style>
