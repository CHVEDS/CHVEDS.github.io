---
interface Props { x?: number; y?: number }
const { x = 36, y = 68 } = Astro.props;
const pos = `left:${x}%;top:${y}%`;
import { desktop } from '@/config/site';
import { getActivity } from '@/lib/github';

const cfg = desktop.activity;
const data = cfg.enabled ? await getActivity(cfg.githubUser, cfg.weeks) : null;
const monthFmt = new Intl.DateTimeFormat('ru-RU', { month: 'short' });
const opacity = [0.1, 0.3, 0.5, 0.75, 1];
const plural = (n: number) => {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return 'вклад';
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'вклада';
  return 'вкладов';
};
---

{
  data ? (
    <a class="widget" style={pos} href={`https://github.com/${cfg.githubUser}`} target="_blank" rel="noopener" data-window>
      <p class="widget__head mono">
        <span>git activity</span>
        <span>
          {monthFmt.format(data.from).replace('.', '')} → {monthFmt.format(data.to).replace('.', '')}
        </span>
      </p>
      <div class="widget__grid" style={`--cols:${data.weeks.length}`}>
        {data.weeks.map((w) => w.map((lvl) => <i style={`opacity:${opacity[lvl] ?? 0.1}`} />))}
      </div>
      <p class="widget__total">
        <b>{data.total}</b> <span class="mono">{plural(data.total)} на GitHub за год</span>
      </p>
    </a>
  ) : (
    import.meta.env.DEV && (
      <div class="widget widget--empty mono" style={pos} data-window>
        <p class="widget__head">
          <span>git activity</span>
        </p>
        <p>Статистика подтянется с GitHub при публикации сайта (локально GitHub может быть недоступен).</p>
      </div>
    )
  )
}

<style>
  .widget {
    position: absolute;
    width: 400px;
    display: block;
    padding: 16px 18px;
    background: rgb(20 21 25 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.07);
    border-radius: var(--radius-lg);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    z-index: 1;
  }

  .widget__head {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .widget__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    gap: 3px;
    height: 92px;
  }

  .widget__grid i {
    background: var(--color-accent);
    border-radius: 2px;
  }

  .widget__total {
    margin-top: 12px;
  }

  .widget__total b {
    font-size: 24px;
  }

  .widget__total span {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .widget--empty {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  @media (max-width: 1100px) {
    .widget {
      position: relative;
      left: auto !important;
      top: auto !important;
      width: auto;
    }
  }
</style>
