---
import { nav, site } from '@/config/site';
import { isActive, url } from '@/lib/utils';

const pathname = Astro.url.pathname;
---

<header class="menubar">
  <a href={url('/')} class="menubar__logo mono" aria-label={`${site.name} — на рабочий стол`}>
    <span class="menubar__tilde">~/</span>{site.handle}
  </a>
  <nav aria-label="Основное меню">
    <ul class="menubar__nav">
      {
        nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isActive(item.href, pathname) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menubar__status mono">
    {site.openToWork && <span class="menubar__open">● открыт к работе</span>}
    <span class="menubar__hide-sm">RU</span>
    <time class="menubar__hide-sm" data-clock></time>
  </div>
</header>

<script>
  const el = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('ru-RU', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    const tick = () => (el.textContent = fmt.format(new Date()).replace(/\./g, '').replace(/,/g, ''));
    tick();
    setInterval(tick, 15000);
  }
</script>

<style>
  .menubar {
    view-transition-name: menubar;
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--menubar-h);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: 0 var(--space-4);
    font-size: var(--text-sm);
    background: rgb(17 18 21 / 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgb(255 255 255 / 0.05);
  }

  .menubar__logo {
    font-weight: 600;
  }

  .menubar__tilde {
    color: var(--color-red);
  }

  .menubar__nav {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .menubar__nav a {
    display: block;
    padding: 2px 10px;
    border-radius: 5px;
    color: #c6c8ce;
  }

  .menubar__nav a:hover {
    background: var(--color-hover);
    color: var(--color-text);
  }

  .menubar__nav a[aria-current='page'] {
    background: rgb(255 255 255 / 0.1);
    color: var(--color-text);
  }

  .menubar__status {
    margin-left: auto;
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .menubar__open {
    color: var(--color-text);
  }

  @media (max-width: 720px) {
    .menubar {
      gap: var(--space-3);
      padding: 0 var(--space-3);
    }

    .menubar__nav {
      display: none;
    }

    .menubar__hide-sm {
      display: none;
    }
  }
</style>
