---
interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---

<div class="empty mono">
  <p class="empty__cmd"><span>❯</span> ls</p>
  <p class="empty__title">{title}</p>
  {text && <p class="empty__text">{text}</p>}
</div>

<style>
  .empty {
    padding: var(--space-8) var(--space-5);
    text-align: center;
    font-size: 13px;
    color: var(--color-text-subtle);
  }

  .empty__cmd span {
    color: var(--color-red);
  }

  .empty__title {
    margin-top: var(--space-3);
    color: var(--color-text);
    font-size: 14px;
  }

  .empty__text {
    margin-top: var(--space-1);
  }
</style>
